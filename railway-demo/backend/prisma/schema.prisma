// Prisma schema for the railway demo. SQLite stores everything in one local
// file (prisma/dev.db), so no database server needs to be running.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Train {
  trainId        Int    @id @map("train_id")
  trainName      String @map("train_name")
  availableSeats Int    @map("available_seats")

  @@map("trains")
}
